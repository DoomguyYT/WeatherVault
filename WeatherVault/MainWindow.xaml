<Window x:Class="WeatherVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherVault"
        mc:Ignorable="d"
        Title="🌤️ WeatherVault" 
        Height="600" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        MinHeight="500" MinWidth="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Margin="0,0,0,15" Background="Transparent">
            <MenuItem Header="⚙️ Настройки" Foreground="White">
                <MenuItem Header="🔑 Сменить API-ключ" Click="ChangeApiKey_Click"/>
                <MenuItem Header="ℹ️ О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Заголовок -->
        <TextBlock Grid.Row="1" Text="🌤️ WeatherVault" 
                   FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="#6C63FF"
                   Margin="0,0,0,15"/>

        <!-- Поиск -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="CityTextBox" 
                     Width="260" 
                     Padding="10"
                     FontSize="14"
                     Background="#2a2a4a"
                     Foreground="White"
                     BorderBrush="#6C63FF"
                     BorderThickness="2"
                     TextChanged="CityTextBox_TextChanged"/>
            <Button x:Name="SearchButton" 
                    Content="🔍 Узнать" 
                    Width="100"
                    Margin="10,0,0,0"
                    Padding="10"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#6C63FF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SearchButton_Click"/>
        </StackPanel>

        <!-- История поиска -->
        <ComboBox x:Name="HistoryComboBox" 
                  Grid.Row="3"
                  Width="370"
                  Height="35"
                  Margin="0,0,0,15"
                  FontSize="12"
                  Background="#2a2a4a"
                  Foreground="White"
                  BorderBrush="#6C63FF"
                  BorderThickness="2"
                  SelectionChanged="HistoryComboBox_SelectionChanged"/>

        <!-- Карточка с погодой -->
        <Border Grid.Row="4" 
                Background="#2a2a4a" 
                CornerRadius="15" 
                Padding="20"
                BorderBrush="#6C63FF"
                BorderThickness="1"
                Margin="0,0,0,15">
            <StackPanel x:Name="WeatherPanel" Visibility="Collapsed">
                <TextBlock x:Name="CityNameText" 
                           FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="White"/>
                <TextBlock x:Name="TemperatureText" 
                           FontSize="48" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#6C63FF"
                           Margin="0,5,0,5"/>
                <TextBlock x:Name="DescriptionText" 
                           FontSize="18" 
                           HorizontalAlignment="Center"
                           Foreground="#a0a0b0"/>
                <TextBlock x:Name="DetailsText" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="#a0a0b0"
                           Margin="0,5,0,0"/>
                <TextBlock x:Name="CacheInfoText" 
                           FontSize="12" 
                           HorizontalAlignment="Center"
                           Foreground="#FFD700"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Статусная строка -->
        <TextBlock x:Name="StatusText" 
                   Grid.Row="5"
                   FontSize="12" 
                   Foreground="#a0a0b0"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
