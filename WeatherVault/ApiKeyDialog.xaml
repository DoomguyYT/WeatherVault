<Window x:Class="WeatherVault.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherVault"
        mc:Ignorable="d"
     Title="🔑 Введите API-ключ OpenWeatherMap" 
        Height="250" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="🔑 Введите ваш API-ключ OpenWeatherMap" 
                   FontSize="16" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" 
                   Text="Получить ключ можно на сайте openweathermap.org после регистрации"
                   FontSize="11" 
                   Foreground="#a0a0b0"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <PasswordBox x:Name="ApiKeyPasswordBox" 
                         Width="300" 
                         Height="40"
                         Padding="10"
                         FontSize="14"
                         Background="#2a2a4a"
                         Foreground="White"
                         BorderBrush="#6C63FF"
                         BorderThickness="2"/>
            <Button Content="👁️" 
                    Width="40"
                    Height="40"
                    Margin="10,0,0,0"
                    FontSize="16"
                    Background="Transparent"
                    Foreground="#a0a0b0"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="ToggleShowPassword_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="✅ Сохранить" 
                    Width="120"
                    Height="40"
                    Padding="10"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#6C63FF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
            <Button Content="❌ Отмена" 
                    Width="100"
                    Height="40"
                    Margin="10,0,0,0"
                    Padding="10"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#ff5f56"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
